---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{ label: string; href: string }>;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  type = 'website',
  publishedDate,
  noindex = false,
  breadcrumbs,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'ToolRank' ? title : `${title} | ToolRank`;
const shareText = encodeURIComponent(`${title} — ${description}`);
const shareUrl = encodeURIComponent(canonicalURL.toString());

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ToolRank',
  url: 'https://toolrank.dev',
  description: 'Agent Tool Optimization (ATO) platform. Score, optimize, and monitor how AI agents discover and select your tools.',
  foundingDate: '2026',
  sameAs: ['https://github.com/imhiroki/toolrank'],
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ToolRank',
  url: 'https://toolrank.dev',
  description: 'The first ATO (Agent Tool Optimization) platform.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://toolrank.dev/score?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ToolRank',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  description: 'Score and optimize MCP tool definitions for AI agent discovery.',
  url: 'https://toolrank.dev',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbSchema = breadcrumbs ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ToolRank', item: 'https://toolrank.dev' },
    ...breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: b.label,
      item: `https://toolrank.dev${b.href}`,
    })),
  ],
} : null;

const navLinks = [
  { href: '/score', label: 'Score' },
  { href: '/framework', label: 'Framework' },
  { href: '/ranking', label: 'Ranking' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/blog', label: 'Blog' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="ToolRank Blog" href="/blog/rss.xml" />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}

  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:site_name" content="ToolRank" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
  {publishedDate && <meta property="article:published_time" content={publishedDate} />}

  <!-- LLMO: Help AI systems understand this page -->
  <meta name="ai-content-declaration" content="original" />
  <link rel="llms-txt" href="/llms.txt" />

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  {Astro.url.pathname === '/' && (
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  )}
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      --bg: #ffffff;
      --bg-s: #f8f8f8;
      --bg-m: #f0f0f0;
      --fg: #111111;
      --fg-2: #444444;
      --fg-3: #777777;
      --fg-4: #aaaaaa;
      --accent: #6d28d9;
      --accent-hover: #5b21b6;
      --accent-s: rgba(109, 40, 217, 0.06);
      --border: #e5e5e5;
      --ok: #059669;
      --warn: #d97706;
      --err: #dc2626;
      --sans: 'Inter', system-ui, -apple-system, sans-serif;
      --mono: 'JetBrains Mono', ui-monospace, monospace;
      --w: 1080px;
      --r: 8px;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #111111; --bg-s: #1a1a1a; --bg-m: #252525;
        --fg: #f5f5f5; --fg-2: #cccccc; --fg-3: #999999; --fg-4: #666666;
        --accent: #a78bfa; --accent-hover: #b39dfa;
        --accent-s: rgba(167, 139, 250, 0.08); --border: #2a2a2a;
      }
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { font-family: var(--sans); color: var(--fg); background: var(--bg); -webkit-font-smoothing: antialiased; }
    body { min-height: 100dvh; line-height: 1.6; display: flex; flex-direction: column; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { color: var(--accent-hover); }
    code { font-family: var(--mono); font-size: 0.85em; background: var(--bg-s); padding: 0.15em 0.4em; border-radius: 4px; }

    .w { width: 100%; max-width: var(--w); margin: 0 auto; padding-inline: 1.25rem; }
    @media (min-width: 640px) { .w { padding-inline: 2rem; } }

    .hdr { position: sticky; top: 0; z-index: 50; background: var(--bg); border-bottom: 1px solid var(--border); }
    .hdr-in { display: flex; align-items: center; justify-content: space-between; height: 3.5rem; }
    .logo { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 1rem; color: var(--fg); letter-spacing: -0.02em; }
    .logo:hover { color: var(--fg); opacity: 0.8; }
    .dnav { display: none; gap: 0.5rem; align-items: center; }
    .dnav a { color: var(--fg-3); font-size: 0.85rem; font-weight: 500; padding: 0.35rem 0.65rem; border-radius: 6px; transition: color 0.15s, background 0.15s; }
    .dnav a:hover { color: var(--fg); background: var(--bg-s); }
    .dnav .gh { margin-left: 0.25rem; padding: 0.35rem; display: flex; }
    .dnav .gh svg { width: 18px; height: 18px; fill: var(--fg-4); transition: fill 0.15s; display: block; }
    .dnav .gh:hover svg { fill: var(--fg); }
    @media (min-width: 640px) { .dnav { display: flex; } .mbtn { display: none; } }
    .mbtn { display: flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; background: none; border: none; cursor: pointer; color: var(--fg-3); border-radius: 6px; -webkit-tap-highlight-color: transparent; }
    .mbtn:hover { background: var(--bg-s); }
    .mnav { display: none; position: fixed; inset: 3.5rem 0 0 0; background: var(--bg); z-index: 100; padding: 0.5rem 1.25rem; flex-direction: column; border-top: 1px solid var(--border); overflow-y: auto; }
    .mnav.open { display: flex; }
    .mnav a { color: var(--fg-2); font-size: 1rem; font-weight: 500; padding: 1rem 0; border-bottom: 1px solid var(--border); }
    .mnav a:last-child { border-bottom: none; }
    .mnav a:hover { color: var(--accent); }
    @media (min-width: 640px) { .mnav { display: none !important; } }

    /* Breadcrumbs */
    .crumbs { padding: 0.75rem 0 0; font-size: 0.7rem; color: var(--fg-4); }
    .crumbs a { color: var(--fg-4); }
    .crumbs a:hover { color: var(--fg-3); }
    .crumbs span { margin: 0 0.3rem; }

    /* Share bar */
    .share-bar { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    .share-btn { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.35rem 0.65rem; font-size: 0.7rem; font-weight: 500; border: 1px solid var(--border); border-radius: 100px; color: var(--fg-3); background: var(--bg); text-decoration: none; transition: border-color 0.15s, color 0.15s; }
    .share-btn:hover { border-color: var(--fg-4); color: var(--fg-2); }

    .ftr { margin-top: auto; border-top: 1px solid var(--border); padding: 2rem 0; }
    .ftr-in { display: flex; flex-direction: column; gap: 1.5rem; font-size: 0.75rem; color: var(--fg-4); }
    .ftr-lk { display: flex; gap: 1rem; flex-wrap: wrap; }
    .ftr-lk a { color: var(--fg-4); }
    .ftr-lk a:hover { color: var(--fg-3); }
    .ftr-nav { display: flex; gap: 2rem; flex-wrap: wrap; }
    .ftr-nav-col { display: flex; flex-direction: column; gap: 0.4rem; }
    .ftr-nav-col strong { color: var(--fg-3); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.2rem; }
    .ftr-nav-col a { color: var(--fg-4); font-size: 0.75rem; }
    .ftr-nav-col a:hover { color: var(--fg-3); }
    @media (min-width: 640px) { .ftr-in { flex-direction: row; justify-content: space-between; align-items: flex-start; } }

    .btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.75rem 1.75rem; border-radius: var(--r); font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: background 0.15s, opacity 0.15s; cursor: pointer; }
    .btn-primary { background: var(--accent); color: #fff; border: none; }
    .btn-primary:hover { background: var(--accent-hover); color: #fff; }
    .btn-ghost { background: transparent; color: var(--fg); border: 1.5px solid var(--border); }
    .btn-ghost:hover { border-color: var(--fg-4); color: var(--fg); }

    .grid-2 { display: grid; grid-template-columns: 1fr; gap: 1rem; }
    @media (min-width: 640px) { .grid-2 { grid-template-columns: repeat(2, 1fr); } }
    .grid-3 { display: grid; grid-template-columns: 1fr; gap: 1rem; }
    @media (min-width: 640px) { .grid-3 { grid-template-columns: repeat(3, 1fr); } }
    .grid-4 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
    @media (min-width: 640px) { .grid-4 { grid-template-columns: repeat(4, 1fr); } }
    .grid-5 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
    @media (min-width: 480px) { .grid-5 { grid-template-columns: repeat(3, 1fr); } }
    @media (min-width: 640px) { .grid-5 { grid-template-columns: repeat(5, 1fr); } }
  </style>
</head>
<body>
  <header class="hdr">
    <nav class="w hdr-in" aria-label="Main navigation">
      <a href="/" class="logo">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="4" fill="var(--accent)"/><path d="M7 12L10.5 15.5L17 8.5" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        ToolRank
      </a>
      <div class="dnav">
        {navLinks.map(l => <a href={l.href}>{l.label}</a>)}
        <a href="https://github.com/imhiroki/toolrank" class="gh" target="_blank" rel="noopener" aria-label="GitHub">
          <svg viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      </div>
      <button class="mbtn" onclick="document.querySelector('.mnav').classList.toggle('open')" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="3" y1="6" x2="19" y2="6"/><line x1="3" y1="11" x2="19" y2="11"/><line x1="3" y1="16" x2="19" y2="16"/></svg>
      </button>
    </nav>
  </header>

  <div class="mnav">
    {navLinks.map(l => <a href={l.href} onclick="document.querySelector('.mnav').classList.remove('open')">{l.label}</a>)}
    <a href="https://github.com/imhiroki/toolrank" target="_blank" rel="noopener" onclick="document.querySelector('.mnav').classList.remove('open')">GitHub</a>
  </div>

  {breadcrumbs && (
    <nav class="w crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      {breadcrumbs.map(b => (
        <><span>/</span><a href={b.href}>{b.label}</a></>
      ))}
    </nav>
  )}

  <main><slot /></main>

  <footer class="ftr">
    <div class="w ftr-in">
      <div>
        <p style="font-weight: 600; color: var(--fg-3); margin-bottom: 0.5rem;">ToolRank</p>
        <p>&copy; 2026 ToolRank. Open source.</p>
      </div>
      <div class="ftr-nav">
        <div class="ftr-nav-col">
          <strong>Product</strong>
          <a href="/score">Score</a>
          <a href="/ranking">Ranking</a>
          <a href="/badge">Badge</a>
          <a href="/pricing">Pricing</a>
        </div>
        <div class="ftr-nav-col">
          <strong>Learn</strong>
          <a href="/framework">ATO Framework</a>
          <a href="/blog">Blog</a>
          <a href="/llms.txt">llms.txt</a>
        </div>
        <div class="ftr-nav-col">
          <strong>Open Source</strong>
          <a href="https://github.com/imhiroki/toolrank">GitHub</a>
          <a href="/sitemap-index.xml">Sitemap</a>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
