---
import Layout from '../../../layouts/Layout.astro';
import { getCategories } from '../../../lib/supabase';

const categories = await getCategories();
const hasData = categories.length > 0;
---

<Layout
  title="MCP Server Rankings by Category"
  breadcrumbs={[{ label: "Ranking", href: "/ranking" }, { label: "Categories", href: "/ranking/category" }]}
  description="Browse MCP server quality rankings by category. Find the best-scored tools for search, databases, APIs, communication, and more."
>
  <section style="padding: 3rem 0 1rem;">
    <div class="w" style="max-width: 900px;">
      <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem;">Category rankings</h1>
      <p style="color: var(--fg-2); font-size: 0.9rem; line-height: 1.6;">
        {hasData
          ? `${categories.length} categories with 2+ scored servers. Click a category to see its full ranking.`
          : 'Category data loading...'}
      </p>
    </div>
  </section>

  <section style="padding: 0 0 4rem;">
    <div class="w" style="max-width: 900px;">
      {hasData ? (
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.75rem;">
          {categories.map((c, i) => {
            const avgColor = c.avg_score >= 85 ? 'var(--accent)' : c.avg_score >= 70 ? 'var(--ok)' : c.avg_score >= 50 ? 'var(--warn)' : 'var(--fg-4)';
            return (
              <a href={`/ranking/category/${encodeURIComponent(c.category)}`}
                style="display: block; border: 1px solid var(--border); border-radius: var(--r); padding: 1rem; text-decoration: none; transition: all 0.15s;"
                class="cat-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                  <p style="font-size: 0.9rem; font-weight: 600; color: var(--fg); text-transform: capitalize;">{c.category}</p>
                  <span style={`font-size: 0.75rem; font-weight: 700; color: ${avgColor};`}>{c.avg_score}</span>
                </div>
                <div style="display: flex; gap: 1rem; font-size: 0.75rem; color: var(--fg-3);">
                  <span>{c.count} servers</span>
                  <span>Avg score: {c.avg_score}/100</span>
                </div>
                <div style="height: 4px; background: var(--border); border-radius: 2px; margin-top: 0.5rem;">
                  <div style={`height: 100%; width: ${c.avg_score}%; background: ${avgColor}; border-radius: 2px;`}></div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div style="text-align: center; padding: 3rem; border: 1px dashed var(--border); border-radius: var(--r);">
          <p style="color: var(--fg-3);">No category data available yet.</p>
        </div>
      )}

      <div style="margin-top: 1.5rem;">
        <a href="/ranking" style="font-size: 0.85rem; color: var(--accent); text-decoration: none;">← View full ranking</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cat-card:hover {
    background: var(--bg-s);
    border-color: var(--accent);
    transform: translateY(-1px);
  }
</style>
