---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  if (!supabase) return [];
  
  try {
    const { data } = await supabase
      .from('latest_scores')
      .select('server_name')
      .order('total_score', { ascending: false })
      .limit(2000);
    
    if (!data) return [];
    return data.map(s => ({
      params: { server: s.server_name },
    }));
  } catch {
    return [];
  }
}

const { server } = Astro.params;

// Get current score
let current = null;
let history = [];

if (supabase && server) {
  try {
    const { data: scoreData } = await supabase
      .from('latest_scores')
      .select('*')
      .eq('server_name', server)
      .single();
    current = scoreData;
  } catch {}

  // Get score history for this server
  try {
    const { data: histData } = await supabase
      .from('scores')
      .select('total_score, findability, clarity, precision, efficiency, scanned_at')
      .eq('server_id', current?.id || '')
      .order('scanned_at', { ascending: true })
      .limit(30);
    history = histData || [];
  } catch {}
}

const levelColors: Record<string, string> = {
  'Dominant': 'var(--accent)',
  'Preferred': 'var(--ok)',
  'Selectable': 'var(--warn)',
  'Visible': 'var(--fg-4)',
  'Absent': 'var(--err)',
};
---

<Layout
  title={current ? `${current.display_name || server} — ToolRank Score` : `${server} — ToolRank`}
  description={current ? `ToolRank Score: ${current.total_score}/100 (${current.level_name}). Findability ${current.findability}, Clarity ${current.clarity}, Precision ${current.precision}, Efficiency ${current.efficiency}.` : `Score details for ${server}.`}
  breadcrumbs={[{ label: 'Ranking', href: '/ranking' }, { label: current?.display_name || server || '', href: `/ranking/${server}` }]}
>
  <section style="padding: 3rem 0 1rem;">
    <div class="w" style="max-width: 720px;">
      {current ? (
        <>
          <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
            <div>
              <h1 style="font-size: 1.75rem; font-weight: 700;">{current.display_name || server}</h1>
              <p style="font-size: 0.8rem; color: var(--fg-4); font-family: var(--mono);">{server}</p>
            </div>
            <div style="margin-left: auto; text-align: right;">
              <p style={`font-size: 2.5rem; font-weight: 700; color: ${levelColors[current.level_name] || 'var(--fg)'};`}>{Math.round(current.total_score)}</p>
              <p style={`font-size: 0.75rem; font-weight: 600; color: ${levelColors[current.level_name] || 'var(--fg-3)'};`}>{current.level_name}</p>
            </div>
          </div>

          <!-- Dimension breakdown -->
          <div style="border: 1px solid var(--border); border-radius: var(--r); padding: 1.25rem; margin-bottom: 1.5rem;">
            <h2 style="font-size: 0.85rem; font-weight: 600; margin-bottom: 1rem;">Score breakdown</h2>
            <div class="grid-4">
              {[
                { label: 'Findability', value: current.findability, max: 25 },
                { label: 'Clarity', value: current.clarity, max: 35 },
                { label: 'Precision', value: current.precision, max: 25 },
                { label: 'Efficiency', value: current.efficiency, max: 15 },
              ].map(d => (
                <div style="text-align: center;">
                  <p style="font-size: 1.25rem; font-weight: 700;">{Math.round(d.value)}</p>
                  <p style="font-size: 0.6rem; color: var(--fg-4);">{d.label} / {d.max}</p>
                  <div style="height: 4px; background: var(--border); border-radius: 2px; margin-top: 0.4rem;">
                    <div style={`height: 100%; width: ${(d.value / d.max) * 100}%; background: var(--accent); border-radius: 2px;`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Score history -->
          {history.length > 1 && (
            <div style="border: 1px solid var(--border); border-radius: var(--r); padding: 1.25rem; margin-bottom: 1.5rem;">
              <h2 style="font-size: 0.85rem; font-weight: 600; margin-bottom: 1rem;">Score history</h2>
              <div style="display: flex; align-items: flex-end; gap: 2px; height: 80px;">
                {history.map(h => {
                  const pct = Math.max(5, (h.total_score / 100) * 100);
                  const date = new Date(h.scanned_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                  return (
                    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px;">
                      <span style="font-size: 0.55rem; color: var(--fg-3);">{Math.round(h.total_score)}</span>
                      <div style={`width: 100%; height: ${pct}%; background: var(--accent); border-radius: 3px 3px 0 0; min-height: 4px;`}></div>
                      <span style="font-size: 0.45rem; color: var(--fg-4); white-space: nowrap;">{date}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          <!-- Selection rate estimate -->
          <div style="border: 1px solid var(--border); border-radius: var(--r); padding: 1.25rem; margin-bottom: 1.5rem;">
            <h2 style="font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem;">Estimated selection rate</h2>
            <p style="font-size: 0.8rem; color: var(--fg-3);">
              {current.total_score >= 85
                ? `At ${Math.round(current.total_score)}/100, agents select tools like this ~85% of the time in competitive scenarios.`
                : current.total_score >= 70
                ? `At ${Math.round(current.total_score)}/100, estimated selection rate: ~13-40%. Improving to 85+ would increase to ~85%.`
                : current.total_score >= 50
                ? `At ${Math.round(current.total_score)}/100, estimated selection rate: ~2-13%. Agents rarely pick tools at this level.`
                : `At ${Math.round(current.total_score)}/100, agents almost never select this tool (<2%).`}
            </p>
            <p style="font-size: 0.65rem; color: var(--fg-4); margin-top: 0.3rem;">
              Based on 500-round simulation (r=0.828). <a href="/framework">Methodology</a>
            </p>
          </div>

          <!-- Metadata -->
          <div style="border: 1px solid var(--border); border-radius: var(--r); padding: 1.25rem; margin-bottom: 1.5rem;">
            <h2 style="font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem;">Details</h2>
            <div style="font-size: 0.8rem; color: var(--fg-3); display: flex; flex-direction: column; gap: 0.4rem;">
              <p><strong>Tools:</strong> {current.tool_count}</p>
              <p><strong>Source:</strong> {current.source || 'smithery'}</p>
              <p><strong>Last scanned:</strong> {new Date(current.scanned_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
            </div>
          </div>

          <!-- Actions -->
          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href={`/score`} class="btn btn-primary" style="font-size: 0.85rem; padding: 0.6rem 1.25rem;">Score this server</a>
            <a href="/ranking" class="btn btn-ghost" style="font-size: 0.85rem; padding: 0.6rem 1.25rem;">← Back to ranking</a>
          </div>

          <!-- Share -->
          <div class="share-bar" style="margin-top: 1.5rem;">
            <a class="share-btn" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`${current.display_name || server} scores ${Math.round(current.total_score)}/100 on ToolRank`)}&url=${encodeURIComponent(`https://toolrank.dev/ranking/${server}`)}`} target="_blank" rel="noopener">𝕏 Share</a>
            <a class="share-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://toolrank.dev/ranking/${server}`)}`} target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </>
      ) : (
        <div style="text-align: center; padding: 4rem 0;">
          <p style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">Server not found</p>
          <p style="color: var(--fg-3); margin-bottom: 1.5rem;">"{server}" is not in our database yet.</p>
          <a href="/ranking" class="btn btn-ghost">View all rankings</a>
        </div>
      )}
    </div>
  </section>
</Layout>
