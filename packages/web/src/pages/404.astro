---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <section style="padding: 6rem 0; text-align: center;">
    <div class="w" style="max-width: 480px;">
      <p style="font-size: 4rem; font-weight: 700; color: var(--accent); margin-bottom: 0.5rem;">404</p>
      <h1 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem;">Page not found</h1>
      <p style="color: var(--fg-3); margin-bottom: 2rem;">The page you're looking for doesn't exist or has been moved.</p>
      <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/score" class="btn btn-ghost">Score your tools</a>
        <a href="/ranking" class="btn btn-ghost">Rankings</a>
      </div>
    </div>
  </section>
</Layout>
