---
import Layout from '../layouts/Layout.astro';
import { getLatestScores, getScoreDistribution, getScanHistory } from '../lib/supabase';

const scores = await getLatestScores(2000);
const dist = await getScoreDistribution();
const history = await getScanHistory(12);
const hasData = scores.length > 0;
const lastUpdated = hasData ? new Date(scores[0].scanned_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : null;

// --- Data cleaning: dedup, test removal, canonical ID ---
const TEST_PATTERNS = /^(vsf|vsfclub|weathermcp|mcp-test|test[-_]|demo[-_]?|hello[-_]|my[-_]?first|sample|example|tutorial|calculator[-_]mcp|test\d|bmp\d|aic[-_]test)/i;
const NOISE_NAMES = new Set(['test', 'demo', 'hello', 'example', 'sample', 'tutorial']);

// Canonical ID: normalize server names to catch duplicates like Rube/Rube1, Context7 variants
function canonicalId(s: any): string {
  const name = (s.server_name || '').toLowerCase().replace(/[-_\s]/g, '');
  // Strip trailing numbers for dedup (Rube vs Rube1)
  const base = name.replace(/\d+$/, '');
  // Use repo as canonical if available (same repo = same server)
  const desc = (s.description || '').toLowerCase();
  return `${base}::${s.source || ''}`;
}

const seen = new Map<string, number>();
const fpCounts = new Map<string, number>();

const dedupedScores = scores.filter(s => {
  const name = s.display_name || s.server_name || '';
  const namePart = (s.server_name || '').split('/').pop() || '';

  // 1. Filter test/tutorial/demo servers
  if (TEST_PATTERNS.test(namePart)) return false;
  if (NOISE_NAMES.has(namePart.toLowerCase())) return false;

  // 2. Filter servers with no meaningful name
  if (namePart.length < 3) return false;

  // 3. Canonical ID dedup: same base name from same source = keep first only
  const cid = canonicalId(s);
  const cidCount = (seen.get(cid) || 0) + 1;
  seen.set(cid, cidCount);
  if (cidCount > 1) return false;

  // 4. Fingerprint dedup: same F/C/P/E = keep max 2
  const fp = `${Math.round(s.findability)}-${Math.round(s.clarity)}-${Math.round(s.precision)}-${Math.round(s.efficiency)}`;
  const fpCount = (fpCounts.get(fp) || 0) + 1;
  fpCounts.set(fp, fpCount);
  if (fpCount > 2) return false;

  return true;
});
---

<Layout
  title="MCP Server Quality Ranking"
  breadcrumbs={[{ label: "Ranking", href: "/ranking" }]}
  description="Live ranking of MCP servers by ToolRank Score. 4,000+ servers scanned, 73% invisible to AI agents. See how your tools compare across Findability, Clarity, Precision, and Efficiency. Updated daily."
>
  <section style="padding: 3rem 0 1rem;">
    <div class="w" style="max-width: 900px;">
      <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem;">Ecosystem ranking</h1>
      <p style="color: var(--fg-2); font-size: 0.9rem; line-height: 1.6;">
        {hasData
          ? `${dist.total || scores.length} MCP servers scored out of 4,000+ scanned. Average: ${dist.average || '—'}/100.`
          : 'First ecosystem scan in progress. Rankings will appear automatically.'}
      </p>
      {hasData && (
        <p style="color: var(--fg-3); font-size: 0.8rem; margin-top: 0.5rem; line-height: 1.6;">
          73% of MCP servers have no tool definitions — they are invisible to AI agents and cannot be scored. 
          <a href="/score" style="color: var(--accent);">Check if your server is visible →</a>
        </p>
      )}
      {lastUpdated && (
        <p style="color: var(--fg-4); font-size: 0.7rem; margin-top: 0.25rem;">
          Last scan: {lastUpdated} · Sources: Smithery + Official MCP Registry · Score v1.0.0 · Updated daily
        </p>
      )}
    </div>
  </section>

  {hasData && dist.total && (
    <section style="padding: 0.5rem 0 1.5rem;">
      <div class="w" style="max-width: 900px;">
        <div class="grid-5">
          {[
            { l: 'Dominant', c: dist.dominant, clr: 'var(--accent)' },
            { l: 'Preferred', c: dist.preferred, clr: 'var(--ok)' },
            { l: 'Selectable', c: dist.selectable, clr: 'var(--warn)' },
            { l: 'Visible', c: dist.visible, clr: 'var(--fg-4)' },
            { l: 'Absent', c: dist.absent, clr: 'var(--err)' },
          ].map(({ l, c, clr }) => (
            <div style="padding: 0.6rem; border-radius: var(--r); background: var(--bg-s); text-align: center;">
              <p style={`font-size: 1.25rem; font-weight: 700; color: ${clr};`}>{c || 0}</p>
              <p style="font-size: 0.6rem; color: var(--fg-4);">{l}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {history.length > 0 && (
    <section style="padding: 0 0 1.5rem;">
      <div class="w" style="max-width: 900px;">
        <div style="border: 1px solid var(--border); border-radius: var(--r); padding: 1.25rem;">
          <h2 style="font-size: 0.85rem; font-weight: 600; margin-bottom: 1rem;">Ecosystem trend</h2>

          {history.length < 3 ? (
            <!-- Not enough data for chart yet -->
            <div style="text-align: center; padding: 1rem 0;">
              <p style="font-size: 0.8rem; color: var(--fg-3);">
                Daily tracking started {new Date(history[0]?.scan_date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}. 
                {history.length === 1 ? '1 scan completed.' : `${history.length} scans completed.`}
              </p>
              <p style="font-size: 0.7rem; color: var(--fg-4); margin-top: 0.25rem;">
                Charts and trend analysis appear after 7 days of data.
              </p>
            </div>
          ) : (
            <!-- Enough data for chart -->
            <div style="display: flex; align-items: flex-end; gap: 2px; height: 80px;">
              {history.map((h) => {
                const pct = Math.max(5, ((h.average_score || 0) / 100) * 100);
                const date = new Date(h.scan_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                return (
                  <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px;">
                    <span style="font-size: 0.55rem; color: var(--fg-3);">{Math.round(h.average_score || 0)}</span>
                    <div style={`width: 100%; height: ${pct}%; background: var(--accent); border-radius: 3px 3px 0 0; min-height: 4px;`}></div>
                    <span style="font-size: 0.5rem; color: var(--fg-4); white-space: nowrap;">{date}</span>
                  </div>
                );
              })}
            </div>
          )}

          <!-- Stats row (always show) -->
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--border);">
            <div style="text-align: center;">
              <p style="font-size: 1rem; font-weight: 700; color: var(--fg);">{dist.total || scores.length}</p>
              <p style="font-size: 0.6rem; color: var(--fg-4);">Servers scored</p>
            </div>
            <div style="text-align: center;">
              <p style="font-size: 1rem; font-weight: 700; color: var(--fg);">{dist.average || '—'}</p>
              <p style="font-size: 0.6rem; color: var(--fg-4);">Average score</p>
            </div>
            <div style="text-align: center;">
              <p style="font-size: 1rem; font-weight: 700; color: var(--accent);">{Math.round(((dist.dominant || 0) / (dist.total || 1)) * 100)}%</p>
              <p style="font-size: 0.6rem; color: var(--fg-4);">Dominant rate</p>
            </div>
          </div>

          <p style="font-size: 0.6rem; color: var(--fg-4); margin-top: 0.5rem;">
            Average score per daily scan. {history.length < 7 ? `${7 - history.length} more days until full trend view.` : `${history.length} data points collected.`}
          </p>
        </div>
      </div>
    </section>
  )}

  {hasData && (
    <section style="padding: 0 0 1rem;">
      <div class="w" style="max-width: 900px;">
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
          <input type="text" id="rank-search" placeholder="Search servers..."
            style="flex: 1; min-width: 200px; padding: 0.6rem 0.875rem; font-size: 0.85rem; border: 1px solid var(--border); border-radius: var(--r); background: var(--bg-s); color: var(--fg); outline: none;" />
          <select id="rank-level" style="padding: 0.5rem 0.75rem; font-size: 0.8rem; border: 1px solid var(--border); border-radius: var(--r); background: var(--bg-s); color: var(--fg); cursor: pointer;">
            <option value="all">All levels</option>
            <option value="Dominant">Dominant (85+)</option>
            <option value="Preferred">Preferred (70-84)</option>
            <option value="Selectable">Selectable (50-69)</option>
          </select>
        </div>
        <div class="share-bar">
          <a class="share-btn" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent('MCP server quality rankings by ToolRank')}&url=https://toolrank.dev/ranking`} target="_blank" rel="noopener">𝕏 Share</a>
          <a class="share-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=https://toolrank.dev/ranking`} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </section>
  )}

  <section style="padding: 0 0 4rem;">
    <div class="w" style="max-width: 900px;">
      {hasData ? (
        <>
          {/* Desktop table */}
          <div class="rank-table-wrap">
            <table class="rank-table" id="rank-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th style="text-align:left;">Server</th>
                  <th data-sort="score">Score ↕</th>
                  <th class="hide-mobile" data-sort="f">F ↕</th>
                  <th class="hide-mobile" data-sort="c">C ↕</th>
                  <th class="hide-mobile" data-sort="p">P ↕</th>
                  <th class="hide-mobile" data-sort="e">E ↕</th>
                  <th>Level</th>
                </tr>
              </thead>
              <tbody>
                {dedupedScores.map((s, i) => {
                  const lvlC = { 'Dominant': 'var(--accent)', 'Preferred': 'var(--ok)', 'Selectable': 'var(--warn)', 'Visible': 'var(--fg-4)', 'Absent': 'var(--err)' };
                  return (
                    <tr data-name={(s.display_name || s.server_name).toLowerCase()} data-level={(() => { if (s.total_score >= 85) return 'Dominant'; if (s.total_score >= 70) return 'Preferred'; if (s.total_score >= 50) return 'Selectable'; return 'Other'; })()} data-score={Math.round(s.total_score)} data-f={Math.round(s.findability)} data-c={Math.round(s.clarity)} data-p={Math.round(s.precision)} data-e={Math.round(s.efficiency)}>
                      <td style="color:var(--fg-4);">{i + 1}</td>
                      <td style="text-align:left;">
                        <a href={`/ranking/${s.server_name}`} style="font-weight:500;color:var(--fg);text-decoration:none;">{s.display_name || s.server_name}</a>
                        {s.display_name && s.display_name !== s.server_name && (
                          <span class="hide-mobile" style="color:var(--fg-4);font-size:0.65rem;margin-left:0.4rem;">{s.server_name}</span>
                        )}
                      </td>
                      <td style="font-weight:600;">{Math.round(s.total_score)}</td>
                      <td class="hide-mobile" style="color:var(--fg-3);">{Math.round(s.findability)}</td>
                      <td class="hide-mobile" style="color:var(--fg-3);">{Math.round(s.clarity)}</td>
                      <td class="hide-mobile" style="color:var(--fg-3);">{Math.round(s.precision)}</td>
                      <td class="hide-mobile" style="color:var(--fg-3);">{Math.round(s.efficiency)}</td>
                      <td>
                        <span style={`font-size:0.65rem;padding:0.15rem 0.4rem;border-radius:100px;background:var(--bg-s);color:${lvlC[s.level_name] || 'var(--fg-4)'};font-weight:500;white-space:nowrap;`}>
                          {s.level_name}
                        </span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      ) : (
        <div style="text-align: center; padding: 3rem 1.5rem; border: 1px dashed var(--border); border-radius: var(--r);">
          <p style="font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem;">Scanning in progress</p>
          <p style="font-size: 0.85rem; color: var(--fg-2);">
            ToolRank is scanning 4,000+ MCP servers. Rankings appear here automatically once the first full scan completes.
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- Level definitions -->
  <section style="padding: 1rem 0;">
    <div class="w" style="max-width: 900px;">
      <div style="border: 1px solid var(--border); border-radius: var(--r); padding: 1rem;">
        <p style="font-size: 0.75rem; font-weight: 600; margin-bottom: 0.5rem;">Score levels</p>
        <div style="font-size: 0.7rem; color: var(--fg-3); line-height: 1.8;">
          <p><span style="color: var(--accent); font-weight: 600;">Dominant (85-100)</span> — Agent picks this tool first in competitive scenarios (~85% selection rate)</p>
          <p><span style="color: var(--ok); font-weight: 600;">Preferred (70-84)</span> — Good quality, selected regularly (~13-40% selection rate)</p>
          <p><span style="color: var(--warn); font-weight: 600;">Selectable (50-69)</span> — Functional but rarely chosen by agents (~2-13% selection rate)</p>
          <p><span style="color: var(--fg-4); font-weight: 600;">Visible (25-49)</span> / <span style="color: var(--err); font-weight: 600;">Absent (0-24)</span> — Nearly invisible to AI agents</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Not listed CTA -->
  <section style="padding: 1rem 0;">
    <div class="w" style="max-width: 900px;">
      <div style="border: 1px dashed var(--border); border-radius: var(--r); padding: 1.25rem; text-align: center;">
        <p style="font-size: 0.9rem; font-weight: 600; margin-bottom: 0.25rem;">Your server not listed?</p>
        <p style="font-size: 0.8rem; color: var(--fg-3); margin-bottom: 0.75rem;">
          If your MCP server isn't in this ranking, it likely has no tool definitions exposed — meaning AI agents can't discover or use it.
        </p>
        <a href="/score" style="display: inline-block; padding: 0.5rem 1.25rem; background: var(--accent); color: #fff; border-radius: var(--r); font-size: 0.8rem; font-weight: 600; text-decoration: none;">
          Check your server →
        </a>
      </div>
    </div>
  </section>

  <section style="padding: 0 0 3rem;">
    <div class="w" style="max-width: 900px; text-align: center;">
      <p style="font-size: 0.7rem; color: var(--fg-4);">
        Scored using open-source Level A engine.
        <a href="https://github.com/imhiroki/toolrank/blob/main/packages/scoring/toolrank_score.py" style="color:var(--fg-4);text-decoration:underline;">View scoring logic</a>.
        Rankings update daily. Selection rates from <a href="/framework" style="color:var(--fg-4);text-decoration:underline;">500-round simulation (r=0.828)</a>.
      </p>
    </div>
  </section>

  {hasData && (
    <script>
      const input = document.getElementById('rank-search');
      const levelSelect = document.getElementById('rank-level');
      const rows = document.querySelectorAll('#rank-table tbody tr');
      
      function filterRows() {
        const q = (input?.value || '').toLowerCase();
        const level = levelSelect?.value || 'all';
        rows.forEach(r => {
          const nameMatch = !q || r.dataset.name?.includes(q);
          const levelMatch = level === 'all' || r.dataset.level === level;
          r.style.display = (nameMatch && levelMatch) ? '' : 'none';
        });
      }
      
      input?.addEventListener('input', filterRows);
      levelSelect?.addEventListener('change', filterRows);

      // Sortable headers
      document.querySelectorAll('.rank-table th[data-sort]').forEach(th => {
        th.style.cursor = 'pointer';
        th.addEventListener('click', () => {
          const col = th.dataset.sort;
          const tbody = document.querySelector('#rank-table tbody');
          const rowsArr = Array.from(tbody.querySelectorAll('tr'));
          const asc = th.dataset.dir === 'asc';
          th.dataset.dir = asc ? 'desc' : 'asc';
          rowsArr.sort((a, b) => {
            const av = parseFloat(a.dataset[col] || '0');
            const bv = parseFloat(b.dataset[col] || '0');
            return asc ? av - bv : bv - av;
          });
          rowsArr.forEach((r, i) => {
            tbody.appendChild(r);
            r.querySelector('td:first-child').textContent = i + 1;
          });
        });
      });
    </script>
  )}

  <style>
    .rank-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .rank-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
    .rank-table th { padding: 0.6rem 0.5rem; color: var(--fg-4); font-weight: 500; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 2px solid var(--border); text-align: center; }
    .rank-table th[data-sort] { cursor: pointer; user-select: none; }
    .rank-table th[data-sort]:hover { color: var(--fg-2); }
    .rank-table td { padding: 0.55rem 0.5rem; border-bottom: 1px solid var(--border); text-align: center; }
    .rank-table tbody tr:hover { background: var(--bg-s); }
    @media (max-width: 639px) {
      .hide-mobile { display: none; }
      .rank-table { font-size: 0.75rem; }
    }
  </style>
</Layout>
