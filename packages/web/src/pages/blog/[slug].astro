---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date,
  author: {
    '@type': 'Person',
    name: post.data.author || 'Hiroki Honda',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolRank',
    url: 'https://toolrank.dev',
  },
  url: `https://toolrank.dev/blog/${post.id}`,
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedDate={post.data.date}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article style="padding: 3rem 0 4rem;">
    <div class="container" style="max-width: 720px;">
      <header style="margin-bottom: 2rem;">
        <p style="font-size: 0.8rem; color: var(--color-text-tertiary); margin-bottom: 0.5rem;">
          {new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          {post.data.author && ` · ${post.data.author}`}
        </p>
        <h1 style="font-size: 2rem; font-weight: 700; line-height: 1.3;">
          {post.data.title}
        </h1>
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border);">
        <a href="/blog" style="font-size: 0.85rem; color: var(--color-accent);">← Back to blog</a>
      </footer>
    </div>
  </article>

  <style>
    .prose {
      font-size: 0.95rem;
      line-height: 1.8;
      color: var(--color-text-secondary);
    }
    .prose h2 {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--color-text);
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }
    .prose h3 {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--color-text);
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
    }
    .prose p {
      margin-bottom: 1rem;
    }
    .prose strong {
      color: var(--color-text);
    }
    .prose a {
      color: var(--color-accent);
    }
    .prose table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      font-size: 0.85rem;
    }
    .prose th, .prose td {
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--color-border);
      text-align: left;
    }
    .prose th {
      color: var(--color-text-tertiary);
      font-weight: 500;
    }
    .prose ul, .prose ol {
      padding-left: 1.5rem;
      margin-bottom: 1rem;
    }
    .prose li {
      margin-bottom: 0.25rem;
    }
    .prose hr {
      border: none;
      border-top: 1px solid var(--color-border);
      margin: 2rem 0;
    }
  </style>
</Layout>
