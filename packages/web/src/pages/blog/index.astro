---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout
  title="Blog"
  breadcrumbs={[{ label: "Blog", href: "/blog" }]}
  description="ATO insights, MCP ecosystem analysis, and agent tool optimization strategies. Data-driven articles updated daily."
>
  <section style="padding: 3rem 0 1.5rem;">
    <div class="w" style="max-width: 720px;">
      <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem;">Blog</h1>
      <p style="color: var(--fg-2); font-size: 0.9rem;">
        ATO insights and MCP ecosystem analysis.
      </p>
    </div>
  </section>

  <section style="padding: 0 0 4rem;">
    <div class="w" style="max-width: 720px;">
      {posts.length > 0 ? (
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          {posts.map(post => (
            <a href={`/blog/${post.id}`} style="display: block; padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--r); text-decoration: none; transition: border-color 0.2s, background 0.2s;" onmouseover="this.style.borderColor='var(--accent)';this.style.background='var(--bg-s)'" onmouseout="this.style.borderColor='var(--border)';this.style.background='transparent'">
              <p style="font-size: 0.75rem; color: var(--fg-4); margin-bottom: 0.5rem;">
                {new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                {post.data.author && ` · ${post.data.author}`}
              </p>
              <h2 style="font-size: 1.15rem; font-weight: 600; color: var(--fg); margin-bottom: 0.5rem; line-height: 1.4;">
                {post.data.title}
              </h2>
              <p style="font-size: 0.875rem; color: var(--fg-2); line-height: 1.6;">
                {post.data.description}
              </p>
            </a>
          ))}
        </div>
      ) : (
        <p style="color: var(--fg-4); font-size: 0.9rem;">No posts yet.</p>
      )}
    </div>
  </section>
</Layout>
