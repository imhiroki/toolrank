---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Score Your Tools"
  description="Get your free ToolRank Score. Paste your MCP tool definition and see how AI agents evaluate your tools across Findability, Clarity, Precision, and Efficiency."
>
  <section style="padding: 3rem 0;">
    <div class="container" style="max-width: 800px;">
      <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem;">Score your tools</h1>
      <p style="color: var(--color-text-secondary); margin-bottom: 2rem; font-size: 0.9rem;">
        Paste your MCP tool definition JSON below. Get your ToolRank Score with specific improvements.
      </p>
    </div>
  </section>

  <section style="padding: 0 0 4rem;">
    <div class="container" style="max-width: 800px;">
      <!-- React island: only this component loads JS -->
      <div id="score-app"></div>
    </div>
  </section>

  <script>
    // Client-side scoring engine (Level A only, runs in browser, zero API cost)
    // This is a simplified version for the browser. Full engine runs server-side.
    
    function scoreToolBrowser(tool) {
      let issues = [];
      let scores = { findability: 0, clarity: 0, precision: 0, efficiency: 0 };
      
      const name = tool.name || 'unknown';
      const desc = tool.description || '';
      const schema = tool.inputSchema || tool.input_schema || {};
      const props = schema.properties || {};
      const required = schema.required || [];
      
      // --- Clarity ---
      let clarityTotal = 0;
      let clarityMax = 6;
      
      // Has description?
      if (!desc.trim()) {
        issues.push({ dim: 'clarity', sev: 'critical', msg: 'No description', fix: 'Add a description explaining purpose, usage, and return value', impact: 15 });
      } else {
        clarityTotal += 1;
        // Length check
        if (desc.length < 20) {
          issues.push({ dim: 'clarity', sev: 'critical', msg: `Description too short (${desc.length} chars)`, fix: 'Expand to 80-200 chars with purpose and context', impact: 10 });
        } else if (desc.length >= 80 && desc.length <= 250) {
          clarityTotal += 1;
        } else if (desc.length >= 50) {
          clarityTotal += 0.7;
        } else {
          clarityTotal += 0.3;
          issues.push({ dim: 'clarity', sev: 'warning', msg: `Description short (${desc.length} chars)`, fix: 'Add usage context. 80-200 chars is optimal', impact: 5 });
        }
        
        // Purpose statement?
        const descLower = desc.toLowerCase().trim();
        if (/^(get|set|create|update|delete|search|find|list|fetch|send|this tool|retriev|return|provid|allow|enabl|perform)/.test(descLower)) {
          clarityTotal += 1;
        } else {
          clarityTotal += 0.5;
          issues.push({ dim: 'clarity', sev: 'warning', msg: 'No clear purpose verb at start', fix: "Start with 'Creates...', 'Retrieves...', or 'This tool...'", impact: 5 });
        }
        
        // Usage context?
        if (/use this|when|useful for|ideal for|designed for|helps|allows|enables|for example/.test(descLower)) {
          clarityTotal += 1;
        } else {
          clarityTotal += 0.4;
          issues.push({ dim: 'clarity', sev: 'warning', msg: 'No usage context', fix: "Add 'Use this when...' to help agents decide", impact: 6 });
        }
        
        // Returns mentioned?
        if (/returns?|outputs?|produces|yields|responds with|result|provides|generates/.test(descLower)) {
          clarityTotal += 1;
        } else {
          clarityTotal += 0.5;
          issues.push({ dim: 'clarity', sev: 'info', msg: 'No return value described', fix: "Add 'Returns...' to describe output", impact: 3 });
        }
        
        // Name-desc alignment
        const nameParts = name.toLowerCase().split(/[_\-]/).filter(p => p.length > 2);
        const matchCount = nameParts.filter(p => descLower.includes(p)).length;
        if (nameParts.length > 0 && matchCount / nameParts.length >= 0.5) {
          clarityTotal += 1;
        } else {
          clarityTotal += 0.5;
        }
      }
      
      scores.clarity = Math.round((clarityTotal / clarityMax) * 35 * 10) / 10;
      
      // --- Precision ---
      let precisionTotal = 0;
      let precisionMax = 5;
      
      if (!schema || !schema.type) {
        issues.push({ dim: 'precision', sev: 'critical', msg: 'No input schema', fix: 'Add inputSchema with type definitions', impact: 12 });
      } else {
        precisionTotal += 1;
        
        const propKeys = Object.keys(props);
        if (propKeys.length > 0) {
          // Type definitions
          const missingTypes = propKeys.filter(k => !props[k].type);
          if (missingTypes.length === 0) precisionTotal += 1;
          else {
            precisionTotal += Math.max(0, 1 - missingTypes.length / propKeys.length);
            issues.push({ dim: 'precision', sev: 'warning', msg: `Missing types: ${missingTypes.join(', ')}`, fix: "Add 'type' to each parameter", impact: 4 });
          }
          
          // Descriptions
          const missingDesc = propKeys.filter(k => !props[k].description);
          if (missingDesc.length === 0) precisionTotal += 1;
          else {
            precisionTotal += Math.max(0, 1 - missingDesc.length / propKeys.length);
            issues.push({ dim: 'precision', sev: 'warning', msg: `Missing param descriptions: ${missingDesc.join(', ')}`, fix: "Add 'description' to each parameter", impact: 5 });
          }
          
          // Required fields
          if (required.length > 0) precisionTotal += 1;
          else {
            precisionTotal += 0.5;
            issues.push({ dim: 'precision', sev: 'info', msg: 'No required fields defined', fix: "Add 'required' array for mandatory params", impact: 3 });
          }
          
          // Enums
          precisionTotal += 1; // simplified
        } else {
          precisionTotal += 2; // no params might be valid
        }
      }
      
      scores.precision = Math.round((precisionTotal / precisionMax) * 25 * 10) / 10;
      
      // --- Efficiency ---
      const tokenEst = JSON.stringify(tool).length / 4;
      let effScore = tokenEst > 2000 ? 0.3 : tokenEst > 1000 ? 0.6 : tokenEst > 500 ? 0.8 : 1.0;
      if (tokenEst > 1000) {
        issues.push({ dim: 'efficiency', sev: 'warning', msg: `~${Math.round(tokenEst)} tokens estimated`, fix: 'Create a compact variant', impact: 3 });
      }
      
      // Name format
      if (!/^[a-z][a-zA-Z0-9_]*$/.test(name)) {
        effScore -= 0.15;
        issues.push({ dim: 'efficiency', sev: 'warning', msg: `Name '${name}' not snake_case/camelCase`, fix: 'Use snake_case or camelCase', impact: 3 });
      }
      if (['run','execute','do','action','tool','function','process','handle'].includes(name.toLowerCase())) {
        effScore -= 0.15;
        issues.push({ dim: 'efficiency', sev: 'warning', msg: `Name '${name}' is too generic`, fix: 'Use specific name like search_users', impact: 5 });
      }
      
      scores.efficiency = Math.round(Math.max(0, effScore) * 15 * 10) / 10;
      
      // --- Findability (limited without registry) ---
      let findScore = 0.5; // default without registry data
      if (name.length < 4) {
        findScore = 0.3;
        issues.push({ dim: 'findability', sev: 'warning', msg: `Name '${name}' too short for search`, fix: 'Use longer, descriptive name', impact: 4 });
      } else {
        findScore = 0.8;
      }
      scores.findability = Math.round(findScore * 25 * 10) / 10;
      
      const total = Math.round((scores.findability + scores.clarity + scores.precision + scores.efficiency) * 10) / 10;
      
      let level, levelName;
      if (total >= 85) { level = 4; levelName = 'Dominant'; }
      else if (total >= 70) { level = 3; levelName = 'Preferred'; }
      else if (total >= 50) { level = 2; levelName = 'Selectable'; }
      else if (total >= 25) { level = 1; levelName = 'Visible'; }
      else { level = 0; levelName = 'Absent'; }
      
      return {
        name,
        total,
        level,
        levelName,
        scores,
        issues: issues.sort((a, b) => b.impact - a.impact),
      };
    }

    // UI Logic
    const app = document.getElementById('score-app');
    
    const exampleJson = JSON.stringify({
      "name": "get_weather",
      "description": "Get the current weather for a location",
      "inputSchema": {
        "type": "object",
        "properties": {
          "location": { "type": "string" }
        },
        "required": ["location"]
      }
    }, null, 2);

    app.innerHTML = `
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 500; margin-bottom: 0.5rem;">
            Paste your MCP tool definition (JSON)
          </label>
          <textarea id="tool-input" rows="12" placeholder='${exampleJson.replace(/'/g, "&#39;")}'
            style="width: 100%; padding: 0.75rem; font-family: var(--font-mono); font-size: 0.8rem;
            border: 1px solid var(--color-border); border-radius: var(--radius);
            background: var(--color-bg-alt); color: var(--color-text); resize: vertical;
            line-height: 1.5;"></textarea>
          <p style="font-size: 0.75rem; color: var(--color-text-tertiary); margin-top: 0.25rem;">
            Supports single tool or {"tools": [...]} server format
          </p>
        </div>
        <button id="score-btn" onclick="runScore()"
          style="align-self: flex-start; padding: 0.65rem 1.5rem; background: var(--color-accent);
          color: white; border: none; border-radius: var(--radius); font-weight: 600;
          font-size: 0.85rem; cursor: pointer;">
          Score
        </button>
        <div id="results"></div>
      </div>
    `;

    function runScore() {
      const input = document.getElementById('tool-input').value.trim();
      const results = document.getElementById('results');
      
      if (!input) {
        results.innerHTML = '<p style="color: var(--color-danger); font-size: 0.85rem;">Paste a tool definition JSON to score.</p>';
        return;
      }
      
      let data;
      try {
        data = JSON.parse(input);
      } catch (e) {
        results.innerHTML = `<p style="color: var(--color-danger); font-size: 0.85rem;">Invalid JSON: ${e.message}</p>`;
        return;
      }
      
      let tools;
      if (data.tools) {
        tools = data.tools;
      } else if (Array.isArray(data)) {
        tools = data;
      } else {
        tools = [data];
      }
      
      const scores = tools.map(t => scoreToolBrowser(t));
      const avg = scores.reduce((s, t) => s + t.total, 0) / scores.length;
      
      const sevColors = { critical: 'var(--color-danger)', warning: 'var(--color-warning)', info: 'var(--color-text-tertiary)' };
      const sevIcons = { critical: '✗', warning: '⚠', info: 'ℹ' };
      const levelColors = ['var(--color-danger)', 'var(--color-warning)', 'var(--color-text-secondary)', 'var(--color-success)', 'var(--color-accent)'];
      
      let html = `
        <div style="padding: 1.5rem; border: 2px solid var(--color-accent); border-radius: var(--radius); margin-bottom: 1.5rem; background: color-mix(in srgb, var(--color-accent) 5%, transparent);">
          <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.5rem;">
            <span style="font-size: 2.5rem; font-weight: 700; color: var(--color-accent);">${Math.round(avg)}</span>
            <span style="font-size: 1rem; color: var(--color-text-tertiary);">/ 100</span>
          </div>
          <p style="font-size: 0.85rem; color: var(--color-text-secondary);">${scores.length} tool${scores.length > 1 ? 's' : ''} analyzed</p>
        </div>
      `;
      
      for (const ts of scores) {
        const pct = Math.round(ts.total);
        html += `
          <div style="border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
              <h3 style="font-size: 1rem; font-weight: 600; font-family: var(--font-mono);">${ts.name}</h3>
              <span style="font-size: 0.8rem; padding: 0.2rem 0.6rem; border-radius: 100px; background: var(--color-bg-alt); color: ${levelColors[ts.level]}; font-weight: 500;">
                Level ${ts.level}: ${ts.levelName}
              </span>
            </div>
            
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-bottom: 1rem;">
              ${['findability', 'clarity', 'precision', 'efficiency'].map(dim => {
                const max = dim === 'clarity' ? 35 : dim === 'efficiency' ? 15 : 25;
                const val = ts.scores[dim];
                const pctDim = Math.round((val / max) * 100);
                return `
                  <div style="text-align: center;">
                    <div style="font-size: 1.25rem; font-weight: 600;">${val}</div>
                    <div style="font-size: 0.65rem; color: var(--color-text-tertiary); text-transform: capitalize;">${dim} / ${max}</div>
                    <div style="height: 3px; background: var(--color-border); border-radius: 2px; margin-top: 0.35rem;">
                      <div style="height: 100%; width: ${pctDim}%; background: var(--color-accent); border-radius: 2px;"></div>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
            
            ${ts.issues.length > 0 ? `
              <div style="border-top: 1px solid var(--color-border); padding-top: 0.75rem;">
                ${ts.issues.map(i => `
                  <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem; font-size: 0.8rem;">
                    <span style="color: ${sevColors[i.sev]}; flex-shrink: 0;">${sevIcons[i.sev]}</span>
                    <div>
                      <span style="color: var(--color-text);">${i.msg}</span>
                      <span style="color: var(--color-text-tertiary);"> — ${i.fix}</span>
                      <span style="color: var(--color-accent); font-size: 0.7rem;"> +${i.impact}pt</span>
                    </div>
                  </div>
                `).join('')}
              </div>
            ` : '<p style="font-size: 0.85rem; color: var(--color-success);">No issues found.</p>'}
          </div>
        `;
      }
      
      results.innerHTML = html;
    }
  </script>
</Layout>
