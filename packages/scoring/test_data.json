{
  "good_server": {
    "name": "github-mcp-server",
    "tools": [
      {
        "name": "create_pull_request",
        "description": "Creates a new pull request in a GitHub repository. Use this when you need to propose changes from one branch to another. Returns the created PR number, URL, and status. Requires repository write access.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "owner": {
              "type": "string",
              "description": "Repository owner (user or organization name)"
            },
            "repo": {
              "type": "string",
              "description": "Repository name"
            },
            "title": {
              "type": "string",
              "description": "Pull request title"
            },
            "body": {
              "type": "string",
              "description": "Pull request description in Markdown format",
              "default": ""
            },
            "head": {
              "type": "string",
              "description": "Branch containing the changes"
            },
            "base": {
              "type": "string",
              "description": "Branch to merge into",
              "default": "main"
            },
            "draft": {
              "type": "boolean",
              "description": "Whether to create as draft PR",
              "default": false
            }
          },
          "required": ["owner", "repo", "title", "head"]
        }
      },
      {
        "name": "search_repositories",
        "description": "Searches for GitHub repositories matching a query. Useful for finding open-source projects, checking if a repository exists, or discovering trending repos. Returns repository name, description, stars, language, and URL.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Search query (supports GitHub search syntax)"
            },
            "sort": {
              "type": "string",
              "description": "Sort field for results",
              "enum": ["stars", "forks", "updated", "help-wanted-issues"],
              "default": "stars"
            },
            "order": {
              "type": "string",
              "description": "Sort order",
              "enum": ["asc", "desc"],
              "default": "desc"
            },
            "per_page": {
              "type": "integer",
              "description": "Number of results per page (max 100)",
              "default": 10
            }
          },
          "required": ["query"]
        }
      }
    ]
  },
  "bad_server": {
    "name": "my-tools",
    "tools": [
      {
        "name": "do",
        "description": "does stuff"
      },
      {
        "name": "get",
        "description": "gets data from the api",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {},
            "format": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "x",
        "description": ""
      }
    ]
  },
  "medium_server": {
    "name": "weather-service",
    "tools": [
      {
        "name": "get_weather",
        "description": "Get the current weather for a specified location",
        "inputSchema": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "City name or coordinates"
            },
            "unit": {
              "type": "string",
              "enum": ["celsius", "fahrenheit"],
              "default": "celsius"
            }
          },
          "required": ["location"]
        }
      }
    ]
  }
}
